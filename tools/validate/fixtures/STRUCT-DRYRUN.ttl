# STRUCT-DRYRUN.ttl —— 元设计承载力演练样本（不是法律内容）
#
# 用途：阶段 1 要求「用一条真实民事规则（含例外 + 抗辩）手工形式化，检验元设计无矛盾承载」。
# 真实规则必须来自 raw/authority/，该目录当前为空（ESC-0002），因此本文件用**显式占位**
# 完成同一结构检验：验证元模型能否同时承载
#   构成要件 4 个（含 1 个开放纹理、1 个消极要件）+ 效果 + 道义模态 + 附属模态
#   + 规范类型（主要/辅助/防御三条）+ 文本版本双层 + 废止条件（特别法优先）
#   + 因子词表 → 因子实例 → 关键事实 → 要件判定 → 适用节点（演绎/类比）→ 候选规则
#
# 硬约束：
#   1. 全部节点带 law:演练标记 true 与 law:非法律结论 true；
#   2. 标识符一律以「演练-」开头，不指向任何真实法律概念、条文或案号；
#   3. 本文件不得被引用为法律依据，不得进入 wiki/ 与 retrieval/ 的法律内容区，
#      由 tools/sync 按 law:演练标记 过滤。
#
# 该文件由 tools/validate 在 --include-fixtures 模式下加载。

@prefix law:  <https://ontology.law-cn.internal/mcl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

# ---------------------------------------------------------------------------
# 1. 规范身份与文本版本（ADR-0003 双层）
# ---------------------------------------------------------------------------

law:演练-抽象规范 a law:抽象规范 ;
    rdfs:label "[演练] 抽象规范"@zh ;
    law:规范名称 "演练用抽象规范（占位）" ;
    law:具有版本 law:演练-版本一 , law:演练-版本二 ;
    law:演练标记 true ;
    law:非法律结论 true ;
    law:锚定计划书条款 "§4.1 元决策二" .

law:演练-版本一 a law:规范文本版本 ;
    rdfs:label "[演练] 文本版本 v1"@zh ;
    law:公布日期 "2000-01-01"^^xsd:date ;
    law:生效日期 "2000-01-01"^^xsd:date ;
    law:失效日期 "2020-01-01"^^xsd:date ;
    law:版本序号 1 ;
    law:文本定位 "演练占位：无对应原文" ;
    law:演练标记 true ;
    law:非法律结论 true .

law:演练-版本二 a law:规范文本版本 ;
    rdfs:label "[演练] 文本版本 v2"@zh ;
    law:公布日期 "2019-12-01"^^xsd:date ;
    law:生效日期 "2020-01-01"^^xsd:date ;
    law:版本序号 2 ;
    law:文本定位 "演练占位：无对应原文" ;
    law:演练标记 true ;
    law:非法律结论 true .

# ---------------------------------------------------------------------------
# 2. 主要规范：4 个要件（要件 3 为开放纹理，要件 4 为消极要件/但书）
# ---------------------------------------------------------------------------

law:演练-规则A a law:规则 ;
    rdfs:label "[演练] 主要规范 R-A"@zh ;
    law:具有要件 law:演练-要件1 , law:演练-要件2 , law:演练-要件3 , law:演练-要件4 ;
    law:具有效果 law:演练-效果A ;
    law:具有模态 law:演练-义务A ;
    law:归属规范类型 law:类型-主要规范 ;
    law:证成状态 law:证成-待检验 ;
    law:判断状态 law:状态-候选 ;
    law:隶属版本 law:演练-版本二 ;
    law:受废止于 law:演练-废止1 ;
    law:演练标记 true ;
    law:非法律结论 true ;
    law:受裁定于 "ESC-0002" .

law:演练-要件1 a law:构成要件 ;
    rdfs:label "[演练] 要件1 合同关系存在"@zh ;
    law:要件序号 1 ;
    law:要件文本 "当事人之间存在有效的合同关系" ;
    law:开放纹理 false ;
    law:消极要件 false ;
    law:锚定因子 law:演练-因子1 ;
    law:演练标记 true ;
    law:非法律结论 true .

law:演练-要件2 a law:构成要件 ;
    rdfs:label "[演练] 要件2 给付义务已届期"@zh ;
    law:要件序号 2 ;
    law:要件文本 "约定的履行期限已经届至" ;
    law:开放纹理 false ;
    law:消极要件 false ;
    law:锚定因子 law:演练-因子2 ;
    law:演练标记 true ;
    law:非法律结论 true .

law:演练-要件3 a law:构成要件 ;
    rdfs:label "[演练] 要件3 对待给付适当（开放纹理）"@zh ;
    law:要件序号 3 ;
    law:要件文本 "对方的对待给付符合约定（边界需价值填充）" ;
    law:开放纹理 true ;
    law:消极要件 false ;
    law:演练标记 true ;
    law:非法律结论 true .

law:演练-要件4 a law:构成要件 ;
    rdfs:label "[演练] 要件4 无合法抗辩事由（消极要件）"@zh ;
    law:要件序号 4 ;
    law:要件文本 "不存在使给付义务消灭的抗辩事由" ;
    law:开放纹理 false ;
    law:消极要件 true ;
    law:演练标记 true ;
    law:非法律结论 true .

law:演练-效果A a law:法律效果 ;
    rdfs:label "[演练] 效果：给付价款"@zh ;
    law:归属效果类型 law:效果-给付 ;
    law:效果内容 "义务人向权利人支付约定数额的金钱" ;
    law:演练标记 true ;
    law:非法律结论 true .

law:演练-义务A a law:义务 ;
    rdfs:label "[演练] 义务模态"@zh ;
    law:模态对象 "支付约定价款" ;
    law:模态期限 "约定期限内" ;
    law:演练标记 true ;
    law:非法律结论 true .

# ---------------------------------------------------------------------------
# 3. 辅助规范与防御规范（元设计须能同时承载三类规范）
# ---------------------------------------------------------------------------

law:演练-规则B a law:规则 ;
    rdfs:label "[演练] 辅助规范 R-B"@zh ;
    law:具有要件 law:演练-要件5 ;
    law:具有效果 law:演练-效果B ;
    law:具有模态 law:演练-义务B ;
    law:归属规范类型 law:类型-辅助规范 ;
    law:证成状态 law:证成-待检验 ;
    law:判断状态 law:状态-候选 ;
    law:隶属版本 law:演练-版本二 ;
    law:解释支撑 law:演练-规则A ;
    law:演练标记 true ;
    law:非法律结论 true .

law:演练-要件5 a law:构成要件 ;
    rdfs:label "[演练] 要件5 解释性条件"@zh ;
    law:要件序号 1 ;
    law:要件文本 "对主要规范中的开放概念作限定解释" ;
    law:开放纹理 true ;
    law:消极要件 false ;
    law:演练标记 true ;
    law:非法律结论 true .

law:演练-效果B a law:法律效果 ;
    rdfs:label "[演练] 效果：解释性限缩"@zh ;
    law:归属效果类型 law:效果-确认 ;
    law:效果内容 "主要规范的适用范围被限缩" ;
    law:演练标记 true ;
    law:非法律结论 true .

law:演练-义务B a law:义务 ;
    rdfs:label "[演练] 义务模态（解释义务）"@zh ;
    law:模态对象 "按限定含义适用主要规范" ;
    law:演练标记 true ;
    law:非法律结论 true .

law:演练-规则C a law:规则 ;
    rdfs:label "[演练] 防御规范 R-C"@zh ;
    law:具有要件 law:演练-要件6 ;
    law:具有效果 law:演练-效果C ;
    law:具有模态 law:演练-禁止C ;
    law:具有附属模态 law:演练-许可C ;
    law:归属规范类型 law:类型-防御规范 ;
    law:证成状态 law:证成-待检验 ;
    law:判断状态 law:状态-候选 ;
    law:隶属版本 law:演练-版本二 ;
    law:冲突于 law:演练-规则A ;
    law:演练标记 true ;
    law:非法律结论 true .

law:演练-要件6 a law:构成要件 ;
    rdfs:label "[演练] 要件6 抗辩事由成立"@zh ;
    law:要件序号 1 ;
    law:要件文本 "存在约定或法定的抗辩事由" ;
    law:开放纹理 true ;
    law:消极要件 false ;
    law:演练标记 true ;
    law:非法律结论 true .

law:演练-效果C a law:法律效果 ;
    rdfs:label "[演练] 效果：请求权受阻"@zh ;
    law:归属效果类型 law:效果-确认 ;
    law:效果内容 "主要规范的法律效果不发生" ;
    law:演练标记 true ;
    law:非法律结论 true .

law:演练-禁止C a law:禁止 ;
    rdfs:label "[演练] 禁止模态"@zh ;
    law:模态对象 "在抗辩成立时仍请求给付" ;
    law:演练标记 true ;
    law:非法律结论 true .

law:演练-许可C a law:许可 ;
    rdfs:label "[演练] 许可模态（附属）"@zh ;
    law:模态对象 "义务人主张抗辩" ;
    law:演练标记 true ;
    law:非法律结论 true .

# ---------------------------------------------------------------------------
# 4. 废止条件（特别法优先 → 必须携带优先规则）
# ---------------------------------------------------------------------------

law:演练-废止1 a law:废止条件 ;
    rdfs:label "[演练] 废止条件：特别法优先"@zh ;
    law:归属废止类型 law:废止-特别法优先 ;
    law:废止对象 law:演练-规则A ;
    law:废止生效日 "2020-01-01"^^xsd:date ;
    law:优先规则 "特别规定优先于一般规定适用" ;
    law:废止理由定位 "演练占位：无对应原文" ;
    law:演练标记 true ;
    law:非法律结论 true .

# ---------------------------------------------------------------------------
# 5. 事实层：词表项 → 因子实例 → 关键事实
# ---------------------------------------------------------------------------

law:演练-因子1 a law:因子词表项 ;
    rdfs:label "[演练] 因子 F-9001 合同签署"@zh ;
    law:因子编号 "F-9001" ;
    law:因子名称 "书面合同经双方签署" ;
    law:典型表述 "双方签订……合同" ;
    law:锚定要件 law:演练-要件1 ;
    law:锚定争点 law:演练-争点1 ;
    law:演练标记 true ;
    law:非法律结论 true .

law:演练-因子2 a law:因子词表项 ;
    rdfs:label "[演练] 因子 F-9002 催告后未履行"@zh ;
    law:因子编号 "F-9002" ;
    law:因子名称 "经催告仍未履行" ;
    law:典型表述 "经催告……仍未支付" ;
    law:锚定要件 law:演练-要件2 ;
    law:演练标记 true ;
    law:非法律结论 true .

law:演练-争点1 a law:争点 ;
    rdfs:label "[演练] 争点：给付义务是否届期"@zh ;
    law:争点描述 "给付义务的履行期限是否已经届至" ;
    law:演练标记 true ;
    law:非法律结论 true .

law:演练-因子实例1 a law:法律因子 ;
    rdfs:label "[演练] 因子实例：合同已签署"@zh ;
    law:因子对应词表项 law:演练-因子1 ;
    law:具有极性 law:极性-正向 ;
    law:因子文本 "双方于演练日期签署书面合同" ;
    law:证据定位 "演练占位：判决书第 3 段" ;
    law:标注者 "演练-标注者" ;
    law:演练标记 true ;
    law:非法律结论 true .

law:演练-因子实例2 a law:法律因子 ;
    rdfs:label "[演练] 因子实例：催告未付"@zh ;
    law:因子对应词表项 law:演练-因子2 ;
    law:具有极性 law:极性-正向 ;
    law:因子文本 "权利人催告后义务人仍未支付" ;
    law:证据定位 "演练占位：判决书第 5 段" ;
    law:标注者 "演练-标注者" ;
    law:演练标记 true ;
    law:非法律结论 true .

law:演练-关键事实1 a law:关键事实 ;
    rdfs:label "[演练] 关键事实：要件1 成立"@zh ;
    law:填充要件 law:演练-要件1 ;
    law:支撑因子 law:演练-因子实例1 ;
    law:推导路径 "因子实例1（正向）→ 要件1 成立" ;
    law:事实结论 "要件1 成立（演练占位结论）" ;
    law:判断状态 law:状态-候选 ;
    law:标注者 "演练-标注者" ;
    law:复核者 "待指定（ESC-0003）" ;
    law:演练标记 true ;
    law:非法律结论 true .

# ---------------------------------------------------------------------------
# 6. 案例层：画像 + 要件判定 + 深层关联
# ---------------------------------------------------------------------------

law:演练-案例1 a law:案例 ;
    rdfs:label "[演练] 案例 1"@zh ;
    law:文书号 "演练-文书-0001" ;
    law:标注版本 "0.1.0-bootstrap" ;
    law:具有因子画像 law:演练-画像1 ;
    law:具有要件判定 law:演练-判定1 ;
    law:具有深层关联 law:演练-关联1 ;
    law:演练标记 true ;
    law:非法律结论 true .

law:演练-画像1 a law:因子画像 ;
    rdfs:label "[演练] 因子画像"@zh ;
    law:画像含因子 law:演练-因子实例1 , law:演练-因子实例2 ;
    law:画像特征向量 "F-9001:+1|F-9002:+1" ;
    law:演练标记 true ;
    law:非法律结论 true .

law:演练-判定1 a law:要件判定 ;
    rdfs:label "[演练] 要件判定：要件1"@zh ;
    law:判定要件 law:演练-要件1 ;
    law:判定结论 law:结论-满足 ;
    law:依据因子 law:演练-因子实例1 ;
    law:说理摘录 "演练占位：说理原文摘录" ;
    law:判断状态 law:状态-候选 ;
    law:演练标记 true ;
    law:非法律结论 true .

law:演练-关联1 a law:深层关联 ;
    rdfs:label "[演练] 深层关联"@zh ;
    law:关联争点 law:演练-争点1 ;
    law:涉及原则 "演练占位：诚信原则" ;
    law:演练标记 true ;
    law:非法律结论 true .

# ---------------------------------------------------------------------------
# 7. 适用层：演绎节点 + 类比节点（产出候选前提并被演绎消费）+ 归纳输出
# ---------------------------------------------------------------------------

law:演练-链1 a law:推理链 ;
    rdfs:label "[演练] 推理链"@zh ;
    law:起源请求 "演练占位：请求支付价款" ;
    law:请求权基础 law:演练-规则A ;
    law:链状态 law:状态-候选 ;
    law:演练标记 true ;
    law:非法律结论 true .

law:演练-节点1 a law:适用节点 ;
    rdfs:label "[演练] 节点1：演绎定位要件"@zh ;
    law:属于链 law:演练-链1 ;
    law:节点序号 1 ;
    law:具有推理模式 law:模式-演绎涵摄 ;
    law:依据 law:演练-规则A ;
    law:产出 law:演练-要件3 ;
    law:判断状态 law:状态-候选 ;
    law:演练标记 true ;
    law:非法律结论 true .

law:演练-节点2 a law:适用节点 ;
    rdfs:label "[演练] 节点2：开放纹理要件触发类比"@zh ;
    law:属于链 law:演练-链1 ;
    law:节点序号 2 ;
    law:具有推理模式 law:模式-类比迁移 ;
    law:依据 law:演练-案例1 ;
    law:产出 law:演练-前提1 ;
    law:判断状态 law:状态-候选 ;
    law:演练标记 true ;
    law:非法律结论 true .

law:演练-前提1 a law:涵摄前提 ;
    rdfs:label "[演练] 候选涵摄前提"@zh ;
    law:前提适用要件 law:演练-要件3 ;
    law:来源先例 law:演练-案例1 ;
    law:类比相似点 "演练占位：两案均存在对待给付争议" ;
    law:类比差异点 "演练占位：给付比例不同" ;
    law:被演绎消费 true ;
    law:消费于 law:演练-节点3 ;
    law:判断状态 law:状态-候选 ;
    law:演练标记 true ;
    law:非法律结论 true .

law:演练-节点3 a law:适用节点 ;
    rdfs:label "[演练] 节点3：演绎消费候选前提"@zh ;
    law:属于链 law:演练-链1 ;
    law:节点序号 3 ;
    law:具有推理模式 law:模式-演绎涵摄 ;
    law:依据 law:演练-前提1 ;
    law:产出 law:演练-关键事实1 ;
    law:判断状态 law:状态-候选 ;
    law:演练标记 true ;
    law:非法律结论 true .

law:演练-候选规则1 a law:候选规则 ;
    rdfs:label "[演练] 候选规则（归纳输出）"@zh ;
    law:具有要件 law:演练-要件3 ;
    law:具有效果 law:演练-效果A ;
    law:具有模态 law:演练-义务A ;
    law:归属规范类型 law:类型-辅助规范 ;
    law:证成状态 law:证成-待检验 ;
    law:判断状态 law:状态-候选 ;
    law:隶属版本 law:演练-版本二 ;
    law:来源案例集 law:演练-案例1 , law:演练-案例2 ;
    law:被演绎消费 false ;
    law:演练标记 true ;
    law:非法律结论 true .

law:演练-案例2 a law:案例 ;
    rdfs:label "[演练] 案例 2（占位，仅用于满足来源案例集≥2）"@zh ;
    law:文书号 "演练-文书-0002" ;
    law:标注版本 "0.1.0-bootstrap" ;
    law:具有因子画像 law:演练-画像2 ;
    law:演练标记 true ;
    law:非法律结论 true .

law:演练-画像2 a law:因子画像 ;
    rdfs:label "[演练] 因子画像 2"@zh ;
    law:画像含因子 law:演练-因子实例2 ;
    law:演练标记 true ;
    law:非法律结论 true .
