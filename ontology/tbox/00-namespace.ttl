# 00-namespace.ttl
# 命名空间、本体头、以及「层」轴（ADR-0006 轴二）与构件根类。
# 全部内容为自建模构件，不含任何法律概念断言（law:非法律结论 true）。
# 修改本文件前必须有 ADR 或 CON（SCHEMA.md §3）。
#
# 本体论约定：模块是「类」（概念靠 subClassOf 归类）；层、状态值是「个体」。
# 这条区分是硬的：模块需要类层级与互斥声明，层与状态值只需可被引用。
#
# 属性类别约定（ADR-0013 §2.3）：
#   owl:ObjectProperty     —— 值是个体，且该关系是法律/结构断言
#   owl:DatatypeProperty   —— 值是字面量，且该字面量是实例的内容
#   owl:AnnotationProperty —— 描述「这个建模产物由谁、依据什么、何时、处于何种状态」
# 判据不是「值是不是字符串」，而是「这条三元组是不是关于世界的断言」。

@prefix law:     <https://ontology.law-cn.internal/mcl#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix vann:    <http://purl.org/vocab/vann/> .

law:本体 a owl:Ontology ;
    # --- 版本（ADR-0013 §2.1：版本 IRI 与术语 IRI 分离）---
    owl:versionIRI <https://ontology.law-cn.internal/mcl/0.2.0> ;
    owl:versionInfo "0.2.0-civil-code" ;
    # --- 命名空间声明（供外部工具与前缀服务识别）---
    vann:preferredNamespacePrefix "law" ;
    vann:preferredNamespaceUri "https://ontology.law-cn.internal/mcl#" ;
    # --- 标准元数据（dcterms）。license/creator/publisher 为发布前置项，见 ADR-0013 §5.3 ---
    dcterms:title "中国民事法律推理本体（受控子领域）"@zh ;
    dcterms:description "以演绎涵摄为验证骨架、在规范发现与事实归类环节显式容纳类比与归纳的自建法律推理本体。未导入任何现成法律本体文件、命名空间或类层级。"@zh ;
    dcterms:created "2026-11-10"^^xsd:date ;
    dcterms:modified "2026-11-10"^^xsd:date ;
    dcterms:language "zh-CN" ;
    # --- 以下三项为 0.1.0 起的自建字段。保留以兼容既有 ADR 与 PROV 引用；
    #     新写入请用 owl:versionIRI / vann: / dcterms: 对应字段（ADR-0013 §2.2）。
    law:本体版本 "0.2.0-civil-code" ;
    law:概念层版本 "0.2.0-civil-code" ;
    law:自建声明 "全部类与属性自建；未导入外部法律本体"@zh ;
    law:锚定计划书条款 "§一.1, §4.1" ;
    law:名称空间 "https://ontology.law-cn.internal/mcl#" ;
    rdfs:label "中国民事法律推理本体（受控子领域）"@zh ;
    rdfs:comment "以演绎涵摄为验证骨架、在规范发现与事实归类环节显式容纳类比与归纳的自建法律推理本体。未导入任何现成法律本体文件、命名空间或类层级。"@zh .

# ---------------------------------------------------------------------------
# 本体头字段（保留兼容，新写入不再使用）
# ---------------------------------------------------------------------------

law:本体版本 a owl:AnnotationProperty ;
    rdfs:label "本体版本"@zh ;
    rdfs:range xsd:string ;
    rdfs:comment "旧版版本字段。新写入请用 owl:versionInfo / owl:versionIRI（ADR-0013 §2.1）。有意省略 domain：仅用于本体头。"@zh .

law:自建声明 a owl:AnnotationProperty ;
    rdfs:label "自建声明"@zh ;
    rdfs:range xsd:string ;
    rdfs:comment "声明未导入外部法律本体。属合规声明，非法律结论。有意省略 domain：仅用于本体头。"@zh .

law:名称空间 a owl:AnnotationProperty ;
    rdfs:label "名称空间"@zh ;
    rdfs:range xsd:string ;
    rdfs:comment "旧版命名空间字段。新写入请用 vann:preferredNamespaceUri。有意省略 domain：仅用于本体头。"@zh .

# ---------------------------------------------------------------------------
# 轴二：层（建模构件的归属）。与轴一「模块」正交，见 ADR-0006。
# 层是个体：构件用 law:所属层 指向它们。
# ---------------------------------------------------------------------------

law:层 a owl:Class ;
    rdfs:label "层"@zh ;
    rdfs:comment "分层架构的层位。与五模块正交：模块管法律概念分类，层管建模构件归属。"@zh .

law:规范层 a law:层 ;
    rdfs:label "规范层"@zh ;
    rdfs:comment "法律规则 = 构成要件 + 法律效果 + 规范类型；含道义模态、文本版本、废止条件。"@zh ;
    law:锚定计划书条款 "§4.2" .

law:事实层 a law:层 ;
    rdfs:label "事实层"@zh ;
    rdfs:comment "生活事实 → 法律因子（论证功能标签，类比操作平面）→ 关键事实（要件事实）。"@zh ;
    law:锚定计划书条款 "§4.2" .

law:案例层 a law:层 ;
    rdfs:label "案例层"@zh ;
    rdfs:comment "因子画像（含极性）+ 要件判定记录 + 深层关联（争点、原则、政策）。"@zh ;
    law:锚定计划书条款 "§4.2" .

law:适用层 a law:层 ;
    rdfs:label "适用层"@zh ;
    rdfs:comment "法律适用节点，携带推理模式标签与判断状态。"@zh ;
    law:锚定计划书条款 "§4.2, §4.3" .

law:元层 a law:层 ;
    rdfs:label "元层"@zh ;
    rdfs:comment "元模型自指层：层、状态值等建模装置本身所属的层位。"@zh ;
    law:锚定计划书条款 "§4.1" .

# 层互不相同（个体层面）。用 AllDifferent 而非 AllDisjointClasses。
[] a owl:AllDifferent ;
    owl:members ( law:规范层 law:事实层 law:案例层 law:适用层 law:元层 ) .

# ---------------------------------------------------------------------------
# 构件根类：所有建模构件的上位类。溯源状态在此声明并由子类继承。
# ---------------------------------------------------------------------------

law:所属层 a owl:ObjectProperty ;
    rdfs:label "所属层"@zh ;
    rdfs:range law:层 ;
    rdfs:comment "构件类的层归属，恰好一个（E-LAYER-01）。构件不受五模块归属约束。有意省略 domain：被 law:构件 的多个不相交子类使用，声明单一 domain 会让 rdfs 推理把所有使用者静默归为构件，掩盖误用。"@zh .

law:构件 a owl:Class ;
    rdfs:label "构件"@zh ;
    rdfs:comment "建模构件（推理结构的零件），不是法律概念。构件不受「必须挂五模块」约束，只受「必须有所属层」约束。"@zh ;
    law:溯源状态 law:溯源-自建设计 ;
    law:非法律结论 true ;
    law:锚定计划书条款 "§4.2" .

law:法律概念 a owl:Class ;
    rdfs:label "法律概念"@zh ;
    rdfs:comment "法律概念的根类。任何法律概念类必须且只能有一个五模块类作为直接上位类（ADR-0006 轴一）。无模块归属者标「悬浮」，禁止入库。"@zh ;
    law:锚定计划书条款 "§5.2, §阶段2" .

# ---------------------------------------------------------------------------
# 通用元数据属性（全部为注释属性：它们描述建模产物，不描述法律事实）
# ---------------------------------------------------------------------------

law:中文标识符 a owl:AnnotationProperty ;
    rdfs:label "中文标识符"@zh ;
    rdfs:range xsd:string ;
    rdfs:comment "与 IRI 局部名一致的中文标识符。发布后只允许废弃+新增，不允许重命名（ADR-0005）。"@zh .

law:英文注释 a owl:AnnotationProperty ;
    rdfs:label "英文注释"@zh ;
    rdfs:range xsd:string ;
    rdfs:comment "可选。仅供外部工具与跨语言检索，不得作为检索主键或标识符来源。机器可读的英文 token 请用 skos:notation。"@zh .

law:锚定计划书条款 a owl:AnnotationProperty ;
    rdfs:label "锚定计划书条款"@zh ;
    rdfs:range xsd:string ;
    rdfs:comment "元设计断言必须锚定计划书条款号，以满足 §5.2 门禁 1 的锚定强制。设计溯源，非法律溯源。"@zh .

law:非法律结论 a owl:AnnotationProperty ;
    rdfs:label "非法律结论"@zh ;
    rdfs:range xsd:boolean ;
    rdfs:comment "true 表示该断言为元设计/结构断言，不含法律实质结论，可豁免判断状态（ADR-0007 §2.2）。"@zh .

law:演练标记 a owl:AnnotationProperty ;
    rdfs:label "演练标记"@zh ;
    rdfs:range xsd:boolean ;
    rdfs:comment "true 表示该节点为结构演练样本，内容为占位，不得作为法律依据引用。"@zh .

law:有意省略domain a owl:AnnotationProperty ;
    rdfs:label "有意省略domain"@zh ;
    rdfs:range xsd:boolean ;
    rdfs:comment "true 表示该属性故意不声明 rdfs:domain，使 W-TERM-05 不再报出（ADR-0013 §2.5）。用于区分「有意省略」与「疏忽遗漏」。"@zh .

# ---------------------------------------------------------------------------
# 溯源登记（ontology/provenance/ 使用的词汇）
# 这些字段描述的是「一批文件的摘要」，属文件级元数据，全部为注释属性。
# ---------------------------------------------------------------------------

law:溯源登记 a owl:Class ;
    rdfs:label "溯源登记"@zh ;
    rdfs:comment "对一批事实源文件（如某版本的 tbox）的溯源汇总，含指纹与逐文件哈希。"@zh .

law:溯源文件项 a owl:Class ;
    rdfs:label "溯源文件项"@zh ;
    rdfs:comment "溯源登记中的单文件条目。"@zh .

law:指纹 a owl:AnnotationProperty ;
    rdfs:label "指纹"@zh ;
    rdfs:range xsd:string ;
    rdfs:comment "对 ontology/tbox/*.ttl 按文件名排序后拼接取 SHA-256。用于检出元设计漂移（CQ-M05）。"@zh .

law:覆盖范围 a owl:AnnotationProperty ;
    rdfs:label "覆盖范围"@zh ;
    rdfs:range xsd:string ;
    rdfs:comment "该指纹覆盖的文件号段（如 00-60 为元模型，7* 为概念层）。"@zh .

law:文件 a owl:ObjectProperty ;
    rdfs:label "文件"@zh ;
    rdfs:domain law:溯源登记 ;
    rdfs:range law:溯源文件项 ;
    rdfs:comment "溯源登记到单文件条目的结构关系。"@zh .

law:文件名 a owl:AnnotationProperty ;
    rdfs:label "文件名"@zh ;
    rdfs:domain law:溯源文件项 ;
    rdfs:range xsd:string .

law:文件指纹 a owl:AnnotationProperty ;
    rdfs:label "文件指纹"@zh ;
    rdfs:domain law:溯源文件项 ;
    rdfs:range xsd:string .

law:行数 a owl:AnnotationProperty ;
    rdfs:label "行数"@zh ;
    rdfs:domain law:溯源文件项 ;
    rdfs:range xsd:integer .
